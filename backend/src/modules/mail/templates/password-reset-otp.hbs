<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Reset Your Reelsgate Password</title>
    <style>
      /* Reset & Base */
      body,
      p,
      h1,
      h2,
      h3,
      table,
      td {
        margin: 0;
        padding: 0;
        font-family:
          -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica,
          Arial, sans-serif;
      }
      body {
        background-color: #0b0c10;
        color: #e2e8f0;
        -webkit-font-smoothing: antialiased;
        padding: 32px 16px;
      }
      .wrapper {
        max-width: 580px;
        margin: 0 auto;
        background: #13151b;
        border: 1px solid #232734;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.45);
      }
      .header-banner {
        background: linear-gradient(135deg, #1b1e28 0%, #111319 100%);
        padding: 40px 32px 28px;
        text-align: center;
        border-bottom: 1px solid #222634;
      }
      .brand-logo-badge {
        display: inline-block;
        background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%);
        color: #ffffff;
        font-weight: 800;
        font-size: 13px;
        letter-spacing: 2px;
        text-transform: uppercase;
        padding: 6px 16px;
        border-radius: 30px;
        margin-bottom: 16px;
      }
      .brand-title {
        font-size: 26px;
        font-weight: 700;
        color: #ffffff;
        letter-spacing: -0.5px;
        margin-bottom: 6px;
      }
      .brand-subtitle {
        font-size: 13px;
        color: #94a3b8;
        letter-spacing: 0.3px;
      }
      .content-body {
        padding: 36px 32px;
      }
      .greeting {
        font-size: 18px;
        font-weight: 600;
        color: #f8fafc;
        margin-bottom: 14px;
      }
      .message-text {
        font-size: 14px;
        line-height: 1.6;
        color: #94a3b8;
        margin-bottom: 28px;
      }
      .otp-container {
        background: #0d0e12;
        border: 1px solid #ef444440;
        border-radius: 16px;
        padding: 24px;
        text-align: center;
        margin: 24px 0 28px;
      }
      .otp-label {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #f87171;
        margin-bottom: 10px;
      }
      .otp-code {
        font-family: 'SF Pro Display', 'Courier New', Courier, monospace;
        font-size: 38px;
        font-weight: 800;
        letter-spacing: 10px;
        color: #ffffff;
        text-shadow: 0 0 16px rgba(239, 68, 68, 0.35);
        margin: 4px 0;
      }
      .otp-timer {
        font-size: 12px;
        color: #64748b;
        margin-top: 10px;
      }
      .security-notice {
        background: #181b24;
        border-left: 3px solid #ef4444;
        border-radius: 8px;
        padding: 14px 16px;
        font-size: 12px;
        line-height: 1.5;
        color: #94a3b8;
        margin-bottom: 28px;
      }
      .footer {
        border-top: 1px solid #1e222d;
        padding: 24px 32px;
        text-align: center;
        background: #0f1015;
      }
      .footer-text {
        font-size: 11px;
        color: #64748b;
        line-height: 1.6;
      }
    </style>
  </head>
  <body>
    <div class='wrapper'>
      <!-- Header -->
      <div class='header-banner'>
        <div class='brand-logo-badge'>Password Recovery</div>
        <div class='brand-title'>Reset Your Password</div>
        <div class='brand-subtitle'>Reelsgate Security Center</div>
      </div>

      <!-- Content -->
      <div class='content-body'>
        <div class='greeting'>Hello{{#if name}}, {{name}}{{/if}},</div>
        <p class='message-text'>
          We received a request to reset the password for your
          <strong>Reelsgate</strong>
          account. Please use the 6-digit verification code below to authorize
          your password reset.
        </p>

        <!-- OTP Box -->
        <div class='otp-container'>
          <div class='otp-label'>Password Reset Code</div>
          <div class='otp-code'>{{otp}}</div>
          <div class='otp-timer'>Expires in
            <strong>{{expiresInMinutes}} minutes</strong></div>
        </div>

        <!-- Security Alert Notice -->
        <div class='security-notice'>
          <strong>Important Security Notice:</strong>
          If you did not request this password reset, someone else may have
          entered your email address by mistake. Your account is still secure,
          and no changes have been made.
        </div>

        <p
          class='message-text'
          style='margin-bottom: 0; font-size: 12px; color: #64748b;'
        >
          For your security, never forward or share this email or OTP code with
          anyone.
        </p>
      </div>

      <!-- Footer -->
      <div class='footer'>
        <p class='footer-text'>
          &copy;
          {{currentYear}}
          Reelsgate. All rights reserved.<br />
          This is an automated system security email.
        </p>
      </div>
    </div>
  </body>
</html>