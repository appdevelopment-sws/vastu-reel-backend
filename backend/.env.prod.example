PORT=8008
NODE_ENV=production

# Database Configuration (MySQL)
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=vastu_user
DB_PASSWORD=your_strong_db_password
DB_DATABASE=vastu_reel_db
DB_ROOT_PASSWORD=your_strong_root_password
MYSQL_DATABASE=vastu_reel_db
MYSQL_USER=vastu_user
MYSQL_PASSWORD=your_strong_db_password
MYSQL_ROOT_PASSWORD=your_strong_root_password
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Security & CORS
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
CORS_ORIGIN=*
JWT_SECRET=your_super_secret_jwt_key_here

# Redis Queue Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# AWS S3 / Cloudflare R2 Configuration (Production Storage)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_CLIENT_ENDPOINT=https://pub-<hash>.r2.dev
S3_REGION=auto
S3_ACCESS_KEY_ID=your_s3_or_r2_access_key
S3_SECRET_ACCESS_KEY=your_s3_or_r2_secret_key
S3_BUCKET_NAME=vastu-video-prod
S3_FORCE_PATH_STYLE=false
