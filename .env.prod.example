# ==============================================================================
# Production Environment Variables Template (.env.prod)
# Copy this to .env or pass through your deployment secret manager
# ==============================================================================

# Application Ports
BACKEND_PORT=8008
FRONTEND_PORT=80

# Database Configuration (MySQL)
DB_HOST_PORT=3306
DB_ROOT_PASSWORD=change_this_to_strong_root_password
DB_DATABASE=vastu_reel_db
DB_USERNAME=vastu_user
DB_PASSWORD=change_this_to_strong_db_password
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Redis Configuration
REDIS_PORT=6379
REDIS_PASSWORD=change_this_to_strong_redis_password

# Authentication & Security
JWT_SECRET=generate_a_long_random_secret_string_here
CORS_ORIGIN=*
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# S3 / Cloudflare R2 / AWS / MinIO Storage Configuration
# If using MinIO container:
S3_ENDPOINT=http://minio:9000
S3_CLIENT_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=change_this_to_strong_minio_password
S3_BUCKET_NAME=vastu-video
S3_FORCE_PATH_STYLE=true
MINIO_PORT=9000

# If using AWS S3 / Cloudflare R2:
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_CLIENT_ENDPOINT=https://pub-<hash>.r2.dev
# S3_REGION=auto
# S3_ACCESS_KEY_ID=your_r2_access_key_id
# S3_SECRET_ACCESS_KEY=your_r2_secret_access_key
# S3_BUCKET_NAME=vastu-reels
# S3_FORCE_PATH_STYLE=false
